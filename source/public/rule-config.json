    "readings": [
      {
        "id": "mistake",
        "title": "解释一个误会",
        "brief": "阅读进度从 0 到 99。钩子只能放在进度 0，后面会额外掉得更快。"
      },
      {
        "id": "fact",
        "title": "把对照摆出来",
        "brief": "事实块衰减慢。放得晚，只改那一格之后的曲线。"
      },
      {
        "id": "turn",
        "title": "中段反转",
        "brief": "反转抬得高、掉得快。和笑话挤在同一进度上不行。"
      },
      {
        "id": "joke",
        "title": "只想被记住一句",
        "brief": "笑话的分享分跟整条曲线的最高点走，不跟时钟走。"
      },
      {
        "id": "open",
        "title": "要不要用挑衅开头",
        "brief": "开头在进度 0 会先抬起来，再按 -0.12×进度 额外下沉，制作技能不加在这截下沉上。"
      },
      {
        "id": "late",
        "title": "后半段才给证据",
        "brief": "进度 70 之前的样本不该被这一块改写。"
      },
      {
        "id": "two",
        "title": "两块就够",
        "brief": "最多三块，每种最多一次。空着也是一种选择。"
      },
      {
        "id": "none",
        "title": "什么都不放",
        "brief": "技能 0、没有块时，高于阈值的进度比例应当是 0.59，最高点在进度 0、高度 60。"
      },
      {
        "id": "mix",
        "title": "事实加笑话",
        "brief": "两种抬升叠在同一条公式上，预览和落版用的是同一条。"
      },
      {
        "id": "last",
        "title": "第十篇阅读",
        "brief": "进度格仍是 0、10、20……90。没有倒计时。"
      }
    ],
